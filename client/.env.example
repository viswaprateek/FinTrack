# Clerk (Dashboard → API Keys → Publishable key)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Post-auth redirect URLs — leave unset in production (defaults to `/`).
# Do NOT point these at protected routes like /dashboard or /onboarding;
# Clerk's handshake does a full-page redirect and those paths 404 on Vercel
# unless vercel.json includes SPA rewrites.
# VITE_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
# VITE_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/

# Backend API — defaults to http://127.0.0.1:8000 if unset
VITE_API_BASE_URL=http://127.0.0.1:8000
