# MySQL connection string. Railway gives you `mysql://...` — that's fine, the app
# rewrites it to `mysql+pymysql://...` for SQLAlchemy at startup.
DATABASE_URL=mysql://user:password@host:3306/railway

DEBUG=true

# Clerk JWT verification (Dashboard → API Keys → Show JWKS URL). Looks like:
# https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Optional: pin the expected token issuer (same host as above, no path). Leave unset
# to skip issuer validation.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
