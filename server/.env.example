# MySQL connection string. The app rewrites `mysql://` to `mysql+pymysql://` for SQLAlchemy.
#
# Local (docker compose): mysql://fintrack_user:fintrack_pass@localhost:3306/fintrack
# Hosted (e.g. Railway):  mysql://user:password@host:3306/railway
DATABASE_URL=mysql://fintrack_user:fintrack_pass@localhost:3306/fintrack

DEBUG=true

# Clerk JWT verification (Dashboard → API Keys → Show JWKS URL). Looks like:
# https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Optional: pin the expected token issuer (same host as above, no path). Leave unset
# to skip issuer validation.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Clerk secret key (Dashboard → API Keys → Secret key, starts with sk_test_ or sk_live_).
# Used by the backend to fetch authoritative profile data via GET /v1/users/{user_id}.
CLERK_SECRET_KEY=sk_test_your_key_here

# Google Gemini — powers the in-app finance assistant (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional — defaults to gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash
